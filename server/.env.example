# ── Server environment ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# "production" | "development"
NODE_ENV=production

# Port the Express server listens on (Heroku sets this automatically)
PORT=5000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your live domain + any previews).
# Example: https://mehdimoradzadeh.com,https://portfolio-preview.vercel.app
ALLOWED_ORIGINS=https://your-production-domain.com

# ── EmailJS Configuration ──────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — NEVER commit real keys to version control.
#
# Steps:
#   1. Sign up at https://www.emailjs.com (free tier = 200 emails/month)
#   2. Add Email Service (Gmail) → copy the Service ID below
#   3. Create an Email Template with variables:
#        {{from_name}}   {{from_email}}   {{message}}
#      Copy the Template ID below.
#   4. Account → API Keys → copy Public Key below.
#   5. IMPORTANT — in the EmailJS dashboard go to:
#        Account → Security → Allowed Origins
#      and add ONLY your production domain (e.g. https://mehdimoradzadeh.com).
#      This prevents anyone else from sending emails using your public key.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
